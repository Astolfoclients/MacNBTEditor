{
  "name": "mac-nbt-editor",
  "displayName": "Mac NBT Editor",
  "description": "A simple Minecraft NBT editor for Mac.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "main.js",
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "start": "electron ."
  },
  "dependencies": {
    "prismarine-nbt": "^2.6.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "@types/vscode": "^1.90.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "typescript-eslint": "^8.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.0.0",
    "ts-loader": "^9.5.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^2.4.0"
  }
}
